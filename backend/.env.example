# Midair.io 設定（このファイルを .env にコピーして使う）
#   cp .env.example .env

# --- データベース ---
# デフォルトは SQLite（ファイル midair.db）
DATABASE_URL=sqlite+aiosqlite:///./midair.db
# MySQL 8.x を使う場合（utf8mb4）:
# DATABASE_URL=mysql+asyncmy://user:password@localhost:3306/midair?charset=utf8mb4

# --- 認証 / JWT ---
# 32文字以上のランダムな文字列に変更すること
SECRET_KEY=change-me-to-a-random-secret-at-least-32-bytes
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- 初期管理者アカウント（初回起動時にシード。.env で必ず変更） ---
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin

# --- Discord OAuth2（設定時のみ有効） ---
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8000/api/auth/discord/callback
FRONTEND_URL=http://localhost:5173

# --- Discord チャット同期（Webhook URL。未設定なら連携オフ） ---
DISCORD_WEBHOOK_URL=

# --- LLM（AIラジオDJ / AIチャットbot。自由思考型） ---
# プロバイダ: auto | gemini | openai
#   auto = OPENAI_API_KEY があれば OpenAI互換、無ければ Gemini を使う
LLM_PROVIDER=auto

# Google Gemini API（Google AI Studio で取得）
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# OpenAI 互換 API（OpenRouter / Groq / OpenAI / ローカル Ollama など）
# base_url を変えるだけで各種サービスに対応
#   Ollama の例:  OPENAI_API_KEY=ollama
#                 OPENAI_BASE_URL=http://localhost:11434/v1
#                 OPENAI_MODEL=gemma3:4b   # 日本語が自然・軽量
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 生成パラメータ（自由思考のまま、暴走・他言語混入を抑える）
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=300

# --- Discord 連携（Miaちゃんのチャットbot・双方向） ---
# discord.py の Gateway で常時接続する Bot。
#   1) https://discord.com/developers/applications でアプリ＋Botを作成
#   2) Bot 設定で「MESSAGE CONTENT INTENT」を ON
#   3) Bot をサーバーへ招待（メッセージ送信・履歴閲覧の権限）
#   4) チャンネルIDを取得（Discordの設定→詳細設定→開発者モードON→チャンネル右クリック→IDをコピー）
DISCORD_BOT_ENABLED=false
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_STATION_CALLSIGN=Miaちゃん

# --- YouTube Data API（任意だが DJ BOT の「流行り曲」取得に必要） ---
# 曲タイトルの取得や、DJ BOT が人気曲チャート(mostPopular)から選曲するのに使用。
# 未設定でも内蔵の埋め込み可能プールから再生する。埋め込み再生自体にキーは不要。
YOUTUBE_API_KEY=

# --- AI DJ の動作 ---
DJ_ENABLED=true
DJ_IDLE_SECONDS=45

# --- 自動DJ局（DJ BOT）: 人気曲からランダムに流し続ける常時オンエア局 ---
DJ_BOT_ENABLED=true
DJ_BOT_FREQUENCY=84.0
# 曲の長さが不明なときのフォールバック秒数（通常は曲の長さぶん再生）
DJ_BOT_INTERVAL_SECONDS=180
# 1曲の最大再生秒数（これを超える長い曲は途中でスキップ／既定10分）
DJ_BOT_MAX_SECONDS=600
# 人気曲チャート（YouTube mostPopular / ミュージック）の地域とキャッシュ時間
DJ_BOT_REGION=JP
DJ_BOT_TRENDING_CACHE_MINUTES=30

# --- 専用局（24時間常設）の自律運行エンジン ---
DEDICATED_ENGINE_ENABLED=true
DEDICATED_ENGINE_INTERVAL_SECONDS=10

# --- 開局できる周波数レンジ（MHz） ---
# 88.9MHz の局が埋まらないよう、上限は 88.9 を既定にする
STATION_FREQ_MIN=76.0
STATION_FREQ_MAX=88.9

# --- CORS ---
CORS_ORIGINS=*

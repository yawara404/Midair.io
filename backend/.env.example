# Midair.io 設定（このファイルを .env にコピーして使う）
#   cp .env.example .env

# --- データベース ---
# デフォルトは SQLite（ファイル midair.db）
DATABASE_URL=sqlite+aiosqlite:///./midair.db
# MySQL 8.x を使う場合（utf8mb4）:
# DATABASE_URL=mysql+asyncmy://user:password@localhost:3306/midair?charset=utf8mb4

# --- 認証 / JWT ---
# 32文字以上のランダムな文字列に変更すること
SECRET_KEY=change-me-to-a-random-secret-at-least-32-bytes
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- 初期管理者アカウント（初回起動時にシード。.env で必ず変更） ---
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin

# --- Discord OAuth2（設定時のみ有効） ---
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8000/api/auth/discord/callback
FRONTEND_URL=http://localhost:5173

# --- Discord チャット同期（Webhook URL。未設定なら連携オフ） ---
DISCORD_WEBHOOK_URL=

# --- LLM（AIラジオDJ / AIチャットbot。自由思考型） ---
# プロバイダ: auto | gemini | openai
#   auto = OPENAI_API_KEY があれば OpenAI互換、無ければ Gemini を使う
LLM_PROVIDER=auto

# Google Gemini API（Google AI Studio で取得）
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# OpenAI 互換 API（OpenRouter / Groq / OpenAI / ローカル Ollama など）
# base_url を変えるだけで各種サービスに対応
#   Ollama の例:  OPENAI_API_KEY=ollama
#                 OPENAI_BASE_URL=http://localhost:11434/v1
#                 OPENAI_MODEL=gemma3:12b  # 日本語が自然・高品質（16GB RAM 推奨）
#                 # 軽量にしたい場合は gemma3:4b
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 生成パラメータ（自由思考のまま、暴走・他言語混入を抑える）
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=300

# --- Discord 連携（Miaちゃんのチャットbot・双方向） ---
# discord.py の Gateway で常時接続する Bot。
#   1) https://discord.com/developers/applications でアプリ＋Botを作成
#   2) Bot 設定で「MESSAGE CONTENT INTENT」を ON
#   3) Bot をサーバーへ招待（メッセージ送信・履歴閲覧の権限）
#   4) チャンネルIDを取得（Discordの設定→詳細設定→開発者モードON→チャンネル右クリック→IDをコピー）
DISCORD_BOT_ENABLED=false
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_STATION_CALLSIGN=Miaちゃん

# --- YouTube Data API（任意だが DJ BOT の「流行り曲」取得に必要） ---
# 曲タイトルの取得や、DJ BOT が人気曲チャート(mostPopular)から選曲するのに使用。
# 未設定でも内蔵の埋め込み可能プールから再生する。埋め込み再生自体にキーは不要。
YOUTUBE_API_KEY=

# --- AI DJ の動作 ---
DJ_ENABLED=true
DJ_IDLE_SECONDS=120
# DJは「DJさん」「hey DJ」と呼びかけられたときだけ返事する（大文字小文字・全角半角は問わない）
#   Discord連携局のMiaちゃんはチャットbotなので常時返事します
#   false にすると従来どおり全てのチャットに返事します
DJ_REPLY_REQUIRES_CALL=true
# 今オンエア中の曲に連動したDJコメント（曲名・歌詞・聴きどころに触れる）
DJ_TRACK_COMMENT_ENABLED=true
# 曲が切り替わった瞬間にDJが曲紹介コメントを投稿する（既定 off）
#   通常は off。DJの「独り口」（DJ_IDLE_SECONDS ごとのひとこと）が今流れている曲に連動します。
#   true にすると、曲の切り替えごとに曲紹介コメントも投稿します。
DJ_TRACK_INTRO_ENABLED=false
# 同じ局で曲紹介を連投しないための最小間隔（秒）
DJ_TRACK_INTRO_COOLDOWN_SECONDS=10
# 誰も聴いていない局では曲紹介をしない（LLM呼び出しの節約）
DJ_TRACK_INTRO_REQUIRES_LISTENER=true

# --- 自動DJ局（DJ BOT）: 人気曲からランダムに流し続ける常時オンエア局 ---
DJ_BOT_ENABLED=true
DJ_BOT_FREQUENCY=84.0
# 曲の長さが不明なときのフォールバック秒数（通常は曲の長さぶん再生）
DJ_BOT_INTERVAL_SECONDS=180
# 1曲の最大再生秒数（これを超える長い曲は途中でスキップ／既定10分）
DJ_BOT_MAX_SECONDS=600
# 人気曲チャート（YouTube mostPopular / ミュージック）の地域とキャッシュ時間
DJ_BOT_REGION=JP
DJ_BOT_TRENDING_CACHE_MINUTES=30
# 直近何曲を重複回避するか（DJ BOT / Vocaloid BOT 共通）
DJ_BOT_RECENT_EXCLUDE=30
# これ以下の再生数の動画は選曲しない（0 で無効）
DJ_BOT_MIN_VIEWS=1000
# 人気曲の優先度（0=完全ランダム / 0.5=控えめに人気曲を優先 / 1.0=再生数に比例）
DJ_BOT_POPULARITY_POWER=0.5

# --- Vocaloid BOT（85.0MHz）: 歌声/ジャンル/年代/プロデューサー/エンジン別の検索を巡回 ---
# 1回のリフレッシュで引くテーマ数（歌声/ジャンル/年代/プロデューサー/エンジンから選ぶ）
#   ※ YouTube search.list は 100ユニット/回。既定は 3テーマ × 16回/日 ≒ 4,800ユニット。
DJ_BOT_VOCALOID_THEMES_PER_REFRESH=3
# テーマを入れ替える間隔（分）。候補は蓄積され、テーマだけが少しずつ変わる。
DJ_BOT_VOCALOID_CACHE_MINUTES=90
# 蓄積する候補プールの上限（この中から直近と重複しない曲をランダムに選曲）
DJ_BOT_VOCALOID_POOL_SIZE=400
# 合成音声歌唱優先: 歌声合成（ボカロ等）のクレジットが確認できる曲だけ流す
#   true  = タイトル/タグ/説明欄/投稿者名のどこかにクレジットが必要（既定）
#           → 人の歌唱（歌ってみた）・インスト・クレジット無しの投稿は流さない
#   false = 投稿者（ボカロP・公式チャンネル）だけで判断する従来動作
DJ_BOT_VOCALOID_SYNTH_ONLY=true
# タイトルに歌声合成のクレジットがある曲（＝合成音声の歌唱とほぼ確実）を
# どれだけ優先するか。選曲の重みに (1 + この値) を掛ける
#   0=優先しない / 1.0=2倍（既定） / 3.0=4倍
DJ_BOT_VOCALOID_SYNTH_BIAS=1.0
# --- 最新の急上昇ボカロを（控えめに）優先する ---
# 公開から DJ_BOT_VOCALOID_FRESH_DAYS 以内の曲の選曲の重みを (1 + この値) 倍する
#   0=優先しない / 0.6=1.6倍（既定。強くしすぎると新曲ばかりになるので控えめに）
DJ_BOT_VOCALOID_FRESH_BIAS=0.6
# 「新曲」とみなす日数（この日数以内は上の倍率、3倍の日数以内は半分の倍率）
DJ_BOT_VOCALOID_FRESH_DAYS=30

# --- 専用局（24時間常設）の自律運行エンジン ---
DEDICATED_ENGINE_ENABLED=true
DEDICATED_ENGINE_INTERVAL_SECONDS=10

# --- 開局できる周波数レンジ（MHz） ---
# 88.9MHz の局が埋まらないよう、上限は 88.9 を既定にする
STATION_FREQ_MIN=76.0
STATION_FREQ_MAX=88.9

# --- 周波数帯の区分（総スロット数は増やさない） ---
# 専用局（24時間常設・申請承認制）を開設できる帯。
# この帯の外は「自由な周波数」＝誰でも自由に開局・時間枠予約できる一般帯。
#   既定: 76.0〜79.9MHz＝専用局帯 / 80.0〜88.9MHz＝自由な周波数
DEDICATED_FREQ_MIN=76.0
DEDICATED_FREQ_MAX=79.9

# --- 切り忘れ対策（放送の停波忘れ防止） ---
# ON AIR からこの分数が過ぎたら自動停波（0 = 無効）
AUTO_OFF_AFTER_MINUTES=360
# 無人（リスナー0人・チャットなし）のままこの分数が過ぎたら自動停波（0 = 無効）
AUTO_OFF_IDLE_MINUTES=120
# 自動停波の何分前に放送内で告知するか（0 = 告知なし）
AUTO_OFF_NOTICE_MINUTES=5

# --- CORS ---
CORS_ORIGINS=*
